<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="greenhub_dashboards.BudgetDashboard">
<div class="gh">
  <t t-if="state.loading and !state.data"><div class="gh-loading">Loading…</div></t>
  <t t-elif="state.loadError">
    <div class="gh-fatal"><h3>Budget &amp; Performance failed to load</h3><p t-esc="state.loadError"/>
      <button t-on-click="() => this.load()">Retry</button></div>
  </t>
  <t t-else="">
  <div t-att-class="state.showCodes ? 'show-codes' : ''">
    <div class="gh-header">
      <div class="gh-hl">
        <div class="gh-eyebrow"><t t-esc="d.company"/> · Green Hub</div>
        <h1 class="gh-title">Budget, Actuals &amp; Performance</h1>
        <div class="gh-meta">
          <span class="gh-pill"><span class="gh-dot"/>Read from Odoo accounting<t t-if="ok('pl') and d.pl.report"> · <t t-esc="d.pl.report"/></t></span>
          <span class="gh-meta-t">Budget: <t t-if="d.budget" t-esc="d.budget.name"/><t t-else="">none selected</t> (Odoo report budget) · operational targets: <t t-if="d.version" t-esc="d.version.name"/><t t-else="">none approved</t></span>
        </div>
      </div>
      <div class="gh-hr" t-if="ok('pl')">
        <div class="gh-logo">GREENHUB<small>DRIVING PROGRESS</small></div>
        <t t-set="hero" t-value="heroTile"/>
        <div class="gh-hero-l"><t t-esc="hero ? hero.label : 'EBITDA'"/> · <t t-esc="periodName"/></div>
        <div class="gh-hero-n lnk" title="Odoo's audit of this P&amp;L cell" t-on-click="() => hero and this.go(hero.drill)"><t t-if="hero"><t t-esc="d.currency"/> <t t-esc="moneyParts(hero.actual).main"/><small t-esc="moneyParts(hero.actual).suffix"/></t><t t-else="">—</t></div>
        <div class="gh-hero-c"><t t-if="hero and hero.budget !== null">vs budget <span class="lnk" t-on-click="() => this.go(hero.plan_drill)" t-esc="fmtMoney(hero.budget)"/></t><t t-elif="hero and hero.fallback">Odoo's standard P&amp;L has no EBITDA line: create the GreenHub P&amp;L variant in settings.</t><t t-else="">No Odoo budget selected.</t></div>
      </div>
    </div>
    <div class="gh-filters">
      <div class="gh-f">Budget (Odoo) <span class="gh-seg">
        <t t-foreach="d.budgets" t-as="b" t-key="b.id">
          <button t-att-class="d.budget and d.budget.id === b.id ? 'on' : ''" t-on-click="() => this.set('budgetId', b.id)" t-esc="b.name"/>
        </t>
        <button t-if="!d.budgets.length" disabled="1">No Odoo budgets yet</button></span></div>
      <div class="gh-f">Targets <span class="gh-seg">
        <t t-foreach="d.versions" t-as="v" t-key="v.id">
          <button t-att-class="d.version and d.version.id === v.id ? 'on' : ''" t-on-click="() => this.set('versionId', v.id)" t-esc="v.name"/>
        </t>
        <button t-if="!d.versions.length" disabled="1">None</button></span></div>
      <div class="gh-f">Period <span class="gh-seg">
        <button t-att-class="state.period === 'month' ? 'on' : ''" t-on-click="() => this.set('period', 'month')">Month</button>
        <button t-att-class="state.period === 'quarter' ? 'on' : ''" t-on-click="() => this.set('period', 'quarter')">Quarter</button>
        <button t-att-class="state.period === 'ytd' ? 'on' : ''" t-on-click="() => this.set('period', 'ytd')">YTD</button></span></div>
      <div class="gh-f">Through
        <select class="gh-select" t-on-change="onThrough">
          <t t-foreach="d.through_options" t-as="m" t-key="m">
            <option t-att-value="m" t-att-selected="d.period.to.slice(0, 7) === m.slice(0, 7)" t-esc="monthName(m)"/>
          </t>
        </select></div>
      <div class="gh-checks">Weekly budget = monthly ÷ days, allocated by day
        <button class="gh-codes-toggle" t-on-click="() => { this.state.showCodes = !this.state.showCodes; }"><t t-if="state.showCodes">Hide</t><t t-else="">Show</t> KPI codes</button></div>
    </div>

    <div class="gh-body">
      <div class="gh-panel-error" t-if="panelError('pl')">P&amp;L failed: <t t-esc="panelError('pl')"/></div>
      <div>
        <h2 class="gh-h2">Performance vs plan · <t t-esc="periodName"/></h2>
        <div class="gh-score">
          <div class="gh-cl" style="flex:4 1 0" t-if="ok('pl')"><div class="gh-cl-l">Financial</div>
            <div class="gh-tiles" style="grid-template-columns:repeat(4,minmax(0,1fr))">
              <t t-foreach="finTiles" t-as="t" t-key="t.code">
                <button class="gh-tile" t-on-click="() => this.go(t.drill)" t-att-title="'Odoo audit of ' + t.label + ' (same as clicking it in the P&amp;L report)'"><span class="kc" t-esc="t.code"/>
                  <div class="gh-tile-l" t-esc="t.label"/>
                  <div class="gh-tile-n"><t t-esc="moneyParts(t.actual).main"/><small t-esc="moneyParts(t.actual).suffix"/></div>
                  <div class="gh-tile-q"><t t-if="t.budget !== null">vs <span class="lnk" title="Odoo P&amp;L with this budget" t-on-click.stop="() => this.go(t.plan_drill)" t-esc="fmtMoney(t.budget)"/> · </t><span t-att-class="'st ' + t.pill.cls" t-esc="t.pill.text"/></div>
                  <span class="gh-rpt" title="Odoo Profit and Loss report for the same period" t-on-click.stop="() => this.report('pl', d.period.from, d.period.to)">P&amp;L ↗</span></button>
              </t>
            </div></div>
          <div class="gh-cl" style="flex:4 1 0" t-if="ok('operational')"><div class="gh-cl-l">Operational</div>
            <div class="gh-tiles" style="grid-template-columns:repeat(4,minmax(0,1fr))">
              <t t-foreach="opsTiles" t-as="t" t-key="t.code">
                <button class="gh-tile" t-on-click="() => this.go(t.drill)"><span class="kc" t-esc="t.code"/>
                  <div class="gh-tile-l" t-esc="t.label"/>
                  <div class="gh-tile-n" t-esc="fmtVal(t.actual, t.unit)"/>
                  <div class="gh-tile-q"><t t-if="t.budget !== null">vs <span class="lnk" title="Open the plan lines" t-on-click.stop="() => this.go(t.plan_drill)" t-esc="fmtVal(t.budget, t.unit)"/> · </t><span t-att-class="'st ' + t.pill.cls" t-esc="t.pill.text"/><t t-if="t.note"><br/><t t-esc="t.note"/></t></div></button>
              </t>
            </div></div>
        </div>
      </div>

      <div class="gh-panel scrollx" t-if="ok('pl')">
        <div class="gh-ptitle"><h3 class="gh-h3">Profit &amp; loss: actual vs budget</h3>
          <span class="gh-rpts"><span style="font:400 12px var(--gh-sans);color:var(--gh-ink-soft)">Actuals open Odoo's audit of the cell · budgets open the Odoo P&amp;L with the budget</span>
            <span class="gh-rpt" t-on-click="() => this.go({kind: 'report', args: {report: 'pl', date_from: d.period.from, date_to: d.period.to, budget_id: d.budget ? d.budget.id : false}})">P&amp;L report ↗</span>
            <span class="gh-rpt" t-on-click="() => this.report('gl', d.period.from, d.period.to)">General Ledger ↗</span>
            <span class="gh-rpt" t-on-click="() => this.report('bs', d.period.from, d.period.to)">Balance Sheet ↗</span></span></div>
        <div class="gh-pcap"><t t-esc="d.currency"/> · lines, signs and totals exactly as <b t-esc="d.pl.report"/> in Accounting › Reporting · variance = (actual − budget) ÷ |budget|</div>
        <table class="t">
          <thead><tr><th>Line</th><th class="r">Month actual</th><th class="r">Month budget</th><th class="r">Period actual</th><th class="r">Period budget</th><th class="r">Variance</th><th class="r">Var %</th><th>Status</th></tr></thead>
          <tbody>
            <t t-foreach="d.pl.lines" t-as="l" t-key="l.key">
              <tr t-att-style="l.key === 'EBITDA' ? 'font-weight:600;border-top:2px solid var(--gh-ink)' : l.total ? 'font-weight:600' : ''" t-on-click="() => this.go(l.drill)">
                <td t-att-style="l.total ? '' : 'padding-left:14px'" t-esc="l.label"/>
                <td class="r lnk" title="Odoo audit, this month" t-on-click.stop="() => this.go(l.month_drill)" t-esc="fmtMoney(l.month_actual)"/>
                <td class="r lnk" title="Odoo P&amp;L with budget, this month" t-on-click.stop="() => this.go(l.month_plan_drill)" t-esc="fmtMoney(l.month_budget)"/>
                <td class="r lnk" title="Odoo audit, whole period" t-on-click.stop="() => this.go(l.drill)" t-esc="fmtMoney(l.actual)"/>
                <td class="r lnk" title="Odoo P&amp;L with budget, whole period" t-on-click.stop="() => this.go(l.plan_drill)" t-esc="fmtMoney(l.budget)"/>
                <td class="r" t-esc="l.variance.abs !== null ? fmtMoney(l.variance.abs) : '—'"/>
                <td class="r" t-esc="l.variance.pct !== null ? l.variance.pct + '%' : 'n/a'"/>
                <td><span t-att-class="'st ' + variancePill(l.variance, l.budget, l.actual).cls" t-esc="variancePill(l.variance, l.budget, l.actual).text"/></td>
              </tr>
            </t>
          </tbody>
        </table>
      </div>

      <div class="gh-row" style="grid-template-columns:minmax(0,1.4fr) minmax(0,1fr)">
        <div class="gh-panel">
          <div class="gh-ptitle"><h3 class="gh-h3">Revenue: actual vs budget by month</h3>
            <span class="gh-rpt" t-if="ok('pl')" t-on-click="() => this.report('pl', d.period.from.slice(0, 4) + '-01-01', d.period.to)">P&amp;L report ↗</span></div>
          <div class="gh-pcap"><t t-esc="d.currency"/> · same unit, one axis</div>
          <t t-if="ok('revenue_by_month') and d.revenue_by_month.rows.length">
            <div class="lg"><span><i class="sw" style="background:var(--gh-slate)"/>Actual</span><span><i class="ln dash" style="border-color:var(--gh-amber)"/>Budget</span></div>
            <GhChart kind="'bar'" config="revenueChart"/>
          </t>
          <div class="empty" t-else=""><b>No Revenue line</b>The selected P&amp;L report has no line coded REV.</div>
        </div>
        <div class="gh-mcard" t-if="ok('outlook')">
          <div class="gh-mhead plum">Year-end outlook · <t t-esc="d.outlook.line"/></div>
          <div class="gh-mbody">
            <div class="wf"><div class="wf-l"><span>Actual YTD <span class="gh-rpt" style="padding:0 6px" t-on-click="() => this.go({kind: 'report', args: {report: 'pl', date_from: d.outlook.ytd_from, date_to: d.outlook.ytd_to}})">P&amp;L ↗</span></span><span class="lnk" title="Odoo audit, year to date" t-on-click="() => this.go(d.outlook.actual_ytd_drill)" t-esc="fmtMoney(d.outlook.actual_ytd)"/></div><div class="wf-b"><i t-att-style="'width:' + outlookWidth(d.outlook.actual_ytd) + '%;background:var(--gh-slate)'"/></div></div>
            <div class="wf"><div class="wf-l"><span>Forecast rest of year <span class="st neu">forecast</span></span><span t-att-class="d.outlook.forecast_drill ? 'lnk' : ''" t-on-click="() => this.go(d.outlook.forecast_drill)" t-esc="fmtMoney(d.outlook.forecast_rest)"/></div>
              <div class="wf-b"><i t-att-style="'width:' + outlookWidth(d.outlook.forecast_rest) + '%;background:repeating-linear-gradient(45deg,var(--gh-blue-step) 0 4px,#cfe0e6 4px 8px)'"/></div></div>
            <div class="wf"><div class="wf-l"><span>Approved budget (full year)</span><span t-att-class="d.outlook.approved_drill ? 'lnk' : ''" t-on-click="() => this.go(d.outlook.approved_drill)" t-esc="fmtMoney(d.outlook.approved_full_year)"/></div><div class="wf-b"><i t-att-style="'width:' + outlookWidth(d.outlook.approved_full_year) + '%;background:var(--gh-amber)'"/></div></div>
            <div class="gh-assume" t-if="!d.outlook.forecast_version">No forecast budget yet: pick an Odoo report budget as "Forecast budget" in settings.</div>
            <div class="gh-fill"/>
            <div class="tot"><div><div class="tot-l">Year-end outlook</div><div class="tot-c">Actual YTD + Odoo forecast budget for the rest of the year. Not the approved budget</div></div>
              <div class="tot-n out lnk" title="Odoo Profit and Loss, year to date" t-on-click="() => this.go({kind: 'report', args: {report: 'pl', date_from: d.outlook.ytd_from, date_to: d.outlook.ytd_to}})" t-esc="fmtMoney(d.outlook.outlook)"/></div>
          </div>
        </div>
      </div>

      <div class="gh-row" style="grid-template-columns:minmax(0,1.4fr) minmax(0,1fr)">
        <div class="gh-panel scrollx" t-if="ok('operational')">
          <h3 class="gh-h3">Operational KPIs vs plan</h3>
          <div class="gh-pcap">Portfolio counts use the end-date value, never a cumulative sum</div>
          <table class="t">
            <thead><tr><th>KPI</th><th>Basis</th><th class="r">Actual</th><th class="r">Plan</th><th>Status</th></tr></thead>
            <tbody>
              <t t-foreach="d.operational.rows" t-as="r" t-key="r_index">
                <tr t-on-click="() => this.go(r.drill)"><td><span class="muted" t-esc="r.code"/> <t t-esc="r.label"/><t t-if="r.note"> <span class="muted" t-esc="r.note"/></t>
                    <span t-if="r.report" class="gh-rpt" style="margin-left:6px;padding:0 6px" t-on-click.stop="() => this.report(r.report, d.period.from, d.period.to)">GL ↗</span></td><td><span class="muted" t-esc="r.basis"/></td>
                  <td class="r lnk" t-on-click.stop="() => this.go(r.drill)" t-esc="fmtVal(r.actual, r.unit)"/><td class="r lnk" title="Open the plan lines" t-on-click.stop="() => this.go(r.plan_drill)" t-esc="fmtVal(r.plan, r.unit)"/>
                  <td><span t-att-class="'st ' + variancePill(r.variance, r.plan, r.actual).cls" t-esc="variancePill(r.variance, r.plan, r.actual).text"/></td></tr>
              </t>
            </tbody>
          </table>
        </div>
        <div class="gh-panel">
          <div class="gh-ptitle"><h3 class="gh-h3">Budgets &amp; targets</h3>
            <a href="#" t-if="d.is_manager" style="font:500 12px var(--gh-sans);color:var(--gh-blue-step)" t-on-click.prevent="() => this.openAction('greenhub_dashboards.action_gh_target_import_wizard')">Import targets .xlsx →</a></div>
          <div class="gh-pcap">P&amp;L budgets are Odoo report budgets, kept by finance in Accounting › Reporting › Profit and Loss. Operational targets (riders, fleet, collections) are kept here</div>
          <table class="t">
            <thead><tr><th>P&amp;L budget (Odoo)</th><th class="r">Lines</th></tr></thead>
            <tbody>
              <t t-foreach="d.budgets" t-as="b" t-key="b.id">
                <tr t-on-click="() => this.go({kind: 'report', args: {report: 'pl', date_from: d.period.from, date_to: d.period.to, budget_id: b.id}})">
                  <td><b t-if="d.budget and d.budget.id === b.id" t-esc="b.name"/><t t-else="" t-esc="b.name"/></td><td class="r" t-esc="b.items"/></tr>
              </t>
              <tr t-if="!d.budgets.length"><td colspan="2" class="muted">No Odoo report budget yet</td></tr>
            </tbody>
          </table>
          <table class="t" style="margin-top:12px">
            <thead><tr><th>Operational targets</th><th>Status</th><th class="r">Lines</th></tr></thead>
            <tbody>
              <t t-foreach="d.versions" t-as="v" t-key="v.id">
                <tr t-on-click="() => this.action.doAction({type: 'ir.actions.act_window', res_model: 'gh.kpi.target.version', res_id: v.id, views: [[false, 'form']]})">
                  <td t-esc="v.name"/>
                  <td><span t-if="v.state === 'approved'" class="st fav">✓ Approved</span><span t-else="" class="st neu">Working</span></td>
                  <td class="r" t-esc="v.lines"/></tr>
              </t>
            </tbody>
          </table>
        </div>
      </div>

      <div class="gh-panel scrollx" t-if="ok('analytic_budgets')">
        <div class="gh-ptitle"><h3 class="gh-h3">Analytic budgets (Odoo Budgets)</h3>
          <span style="font:400 12px var(--gh-sans);color:var(--gh-ink-soft)">Budgets overlapping the period · planned, achieved and theoretical exactly as Odoo computes them</span></div>
        <div class="gh-pcap">Click a budget to open it in Odoo, a line (or its achieved amount) for the entries behind it, "Report" for Odoo's budget analysis</div>
        <div class="empty" t-if="!d.analytic_budgets.budgets.length"><b>No analytic budget overlaps this period</b>Create one in Accounting › Budgets.</div>
        <table class="t" t-else="">
          <thead><tr><th>Budget / analytic line</th><th>Status</th><th class="r">Planned</th><th class="r">Theoretical</th><th class="r">Achieved</th><th class="r">Achieved %</th></tr></thead>
          <tbody>
            <t t-foreach="d.analytic_budgets.budgets" t-as="b" t-key="b.id">
              <tr style="font-weight:600" t-on-click="() => this.drill('budget', {budget_id: b.id, label: b.name})">
                <td><t t-esc="b.name"/> <span class="muted" t-esc="shortDate(b.from) + ' – ' + shortDate(b.to)"/>
                  <span class="gh-rpt" style="margin-left:6px;padding:0 6px" t-on-click.stop="() => this.drill('budget_report', {budget_id: b.id})">Report ↗</span></td>
                <td><span t-att-class="'st ' + (b.state === 'draft' ? 'neu' : 'fav')" t-esc="b.state_label"/></td>
                <td class="r" t-esc="fmtMoney(b.planned)"/><td/><td class="r" t-esc="fmtMoney(b.achieved)"/><td/></tr>
              <t t-foreach="b.lines" t-as="l" t-key="l.id">
                <tr t-on-click="() => this.drill('budget_entries', {line_id: l.id, label: b.name + ' · ' + l.label})">
                  <td style="padding-left:14px" t-esc="l.label"/><td/>
                  <td class="r" t-esc="fmtMoney(l.planned)"/><td class="r" t-esc="fmtMoney(l.theoretical)"/>
                  <td class="r lnk" t-on-click.stop="() => this.drill('budget_entries', {line_id: l.id, label: b.name + ' · ' + l.label})" t-esc="fmtMoney(l.achieved)"/>
                  <td class="r"><span t-if="l.pct !== null" t-att-class="'st ' + (l.above ? 'unf' : 'neu')" t-esc="l.pct + '%'"/></td></tr>
              </t>
            </t>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  </t>
</div>
</t>
</templates>
