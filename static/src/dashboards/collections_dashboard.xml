<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="greenhub_dashboards.CollectionsDashboard">
<div class="gh">
  <t t-if="state.loading and !state.data"><div class="gh-loading">Loading…</div></t>
  <t t-elif="state.loadError">
    <div class="gh-fatal"><h3>Collections &amp; Payments failed to load</h3><p t-esc="state.loadError"/>
      <button t-on-click="() => this.load()">Retry</button></div>
  </t>
  <t t-else="">
  <div t-att-class="state.showCodes ? 'show-codes' : ''">
    <div class="gh-header">
      <div class="gh-hl">
        <div class="gh-eyebrow"><t t-esc="d.company"/> · Green Hub</div>
        <h1 class="gh-title">Collections &amp; Payments</h1>
        <div class="gh-meta">
          <span class="gh-pill"><span class="gh-dot"/>Live · successful mobile-money receipts</span>
          <span class="gh-meta-t" t-if="ok('core')"><t t-esc="periodTitle"/> · cash collected, not accounting revenue</span>
        </div>
      </div>
      <div class="gh-hr" t-if="ok('core')">
        <div class="gh-logo">GREENHUB<small>DRIVING PROGRESS</small></div>
        <div class="gh-hero-l">Cash collected · <t t-if="c.period.key === 'this_month'">MTD</t><t t-else="">period</t></div>
        <div class="gh-hero-n"><t t-esc="d.currency"/> <t t-esc="heroParts.main"/><small t-esc="heroParts.suffix"/></div>
        <div class="gh-hero-c">All successful receipts across lease, rental, deposits, swaps, late fees and spare parts.</div>
      </div>
    </div>
    <div class="gh-filters">
      <div class="gh-f">Period <span class="gh-seg">
        <button t-att-class="state.period === 'this_month' ? 'on' : ''" t-on-click="() => this.set('period', 'this_month')">This month</button>
        <button t-att-class="state.period === 'last_month' ? 'on' : ''" t-on-click="() => this.set('period', 'last_month')">Last month</button>
        <button t-att-class="state.period === 'custom' ? 'on' : ''" t-on-click="() => { this.state.period = 'custom'; }">Custom</button></span>
        <t t-if="state.period === 'custom'">
          <input type="date" class="gh-input" t-att-value="state.dateFrom || ''" t-on-change="(ev) => this.onDate('dateFrom', ev)"/>
          <input type="date" class="gh-input" t-att-value="state.dateTo || ''" t-on-change="(ev) => this.onDate('dateTo', ev)"/>
        </t>
      </div>
      <div class="gh-f">Trend <span class="gh-seg">
        <button t-att-class="state.grain === 'week' ? 'on' : ''" t-on-click="() => this.set('grain', 'week')">Week</button>
        <button t-att-class="state.grain === 'month' ? 'on' : ''" t-on-click="() => this.set('grain', 'month')">Month</button></span></div>
      <div class="gh-f">Product <span class="gh-seg">
        <button t-att-class="!state.productGroupId ? 'on' : ''" t-on-click="() => this.set('productGroupId', false)">All</button>
        <t t-foreach="d.product_groups" t-as="g" t-key="g.id">
          <button t-att-class="state.productGroupId === g.id ? 'on' : ''" t-on-click="() => this.set('productGroupId', g.id)" t-esc="g.name"/>
        </t></span></div>
      <div class="gh-f" t-if="d.fx_currency">Currency <span class="gh-seg">
        <button t-att-class="state.currency === 'company' ? 'on' : ''" t-on-click="() => this.set('currency', 'company')">UGX</button>
        <button t-att-class="state.currency === 'usd' ? 'on' : ''" t-on-click="() => this.set('currency', 'usd')" t-esc="d.fx_currency"/></span></div>
      <div class="gh-checks">
        <button t-on-click="() => { this.state.showChecks = !this.state.showChecks; }">
          <t t-if="checksFailed.length"><span class="bad">⚠</span> <t t-esc="c and c.unmapped_count"/> receipts unmapped</t>
          <t t-else=""><span class="ok">✓</span> Categories = total receipts · 0 unmapped</t>
        </button>
        <button class="gh-codes-toggle" t-on-click="() => { this.state.showCodes = !this.state.showCodes; }"><t t-if="state.showCodes">Hide</t><t t-else="">Show</t> KPI codes</button>
      </div>
    </div>
    <div class="gh-check-list" t-if="state.showChecks">
      <t t-foreach="d.checks" t-as="ch" t-key="ch.code"><div><t t-if="ch.ok">✓</t><t t-else="">⚠</t> <b t-esc="ch.code"/> · <t t-esc="ch.message"/></div></t>
    </div>

    <div class="gh-body">
      <div class="gh-panel-error" t-if="panelError('core')">Collections KPIs failed: <t t-esc="panelError('core')"/></div>
      <t t-if="ok('core')">
      <div>
        <h2 class="gh-h2">Collections at a glance</h2>
        <div class="gh-score">
          <div class="gh-cl" style="flex:3 1 0"><div class="gh-cl-l"><t t-if="c.period.key === 'this_month'">This month</t><t t-else="">Period</t></div>
            <div class="gh-tiles" style="grid-template-columns:repeat(3,minmax(0,1fr))">
              <button class="gh-tile" t-on-click="() => this.open('payment.log', c.domain, 'Receipts')"><span class="kc">C01</span>
                <div class="gh-tile-l">Lease collections</div>
                <div class="gh-tile-n"><t t-esc="moneyParts(c.lease).main"/><small t-esc="moneyParts(c.lease).suffix"/></div>
                <div class="gh-tile-q">excl. late fees <t t-esc="fmtMoney(c.late_fees)"/> · deposits <t t-esc="fmtMoney(c.deposits)"/></div></button>
              <button class="gh-tile" t-on-click="() => this.open('payment.schedule', c.due_domain, 'Lease instalments due')"><span class="kc">C02</span>
                <div class="gh-tile-l">Lease instalments due</div>
                <div class="gh-tile-n"><t t-esc="moneyParts(c.lease_due).main"/><small t-esc="moneyParts(c.lease_due).suffix"/></div>
                <div class="gh-tile-q">scheduled in the period</div></button>
              <button class="gh-tile" disabled="1"><span class="kc">C03</span>
                <div class="gh-tile-l">Collection progress</div>
                <div class="gh-tile-n"><t t-esc="c.progress ?? '—'"/><small>%</small></div>
                <div class="gh-tile-q">cash ÷ due<t t-if="c.period.days"> · <t t-esc="proRataPct"/>% of month elapsed</t> · <t t-esc="fmtPct(c.compliance)"/> of instalments paid</div></button>
            </div></div>
          <div class="gh-cl" style="flex:2 1 0"><div class="gh-cl-l">Target</div>
            <div class="gh-tiles" style="grid-template-columns:repeat(2,minmax(0,1fr))">
              <button class="gh-tile" disabled="1"><span class="kc">C06</span>
                <div class="gh-tile-l">Collections vs target</div>
                <div class="gh-tile-n"><t t-esc="c.vs_target ?? '—'"/><small t-if="c.vs_target !== null">%</small></div>
                <div class="gh-tile-q"><t t-if="c.target_total !== null">of <t t-esc="d.currency"/> <t t-esc="fmtMoney(c.target_total)"/> target · <t t-esc="c.version"/></t><t t-else="">no approved target version</t></div></button>
              <button class="gh-tile" disabled="1"><span class="kc">C07</span>
                <div class="gh-tile-l">Variance to pro-rata target</div>
                <div t-att-class="'gh-tile-n' + (c.variance !== null ? (c.variance >= 0 ? ' good' : ' crit') : '')"><t t-esc="c.variance !== null ? fmtMoney(c.variance) : '—'"/></div>
                <div class="gh-tile-q" t-if="c.variance !== null"><span t-att-class="'st ' + (c.variance >= 0 ? 'fav' : 'unf')"><t t-if="c.variance >= 0">▲ Favourable</t><t t-else="">▼ Unfavourable</t></span> <t t-esc="fmtPct(c.variance_pct)"/></div></button>
            </div></div>
          <div class="gh-cl" style="flex:2 1 0" t-if="ok('rates')"><div class="gh-cl-l">Rates · <t t-esc="d.rates.month"/></div>
            <div class="gh-tiles" style="grid-template-columns:repeat(2,minmax(0,1fr))">
              <button class="gh-tile" disabled="1"><span class="kc">C08</span>
                <div class="gh-tile-l">Active-contract rate</div>
                <div class="gh-tile-n good"><t t-esc="d.rates.active_rate ?? '—'"/><small>%</small></div>
                <div class="gh-tile-q">collected ÷ due, Running + Paused</div></button>
              <button class="gh-tile" disabled="1"><span class="kc">C09</span>
                <div class="gh-tile-l">Entire-fleet rate</div>
                <div class="gh-tile-n warn"><t t-esc="d.rates.fleet_rate ?? '—'"/><small>%</small></div>
                <div class="gh-tile-q">incl. <t t-esc="d.rates.available"/> available bikes at the standard instalment</div></button>
            </div></div>
        </div>
      </div>

      <div class="gh-row" style="grid-template-columns:minmax(0,1.5fr) minmax(0,1fr)">
        <div class="gh-panel scrollx"><span class="kc">C04–C07</span>
          <div class="gh-ptitle"><h3 class="gh-h3">Cash collected by category vs target</h3><span style="font:400 12px var(--gh-sans);color:var(--gh-ink-soft)">Targets maintained in Odoo (Budget &amp; targets)</span></div>
          <div class="gh-pcap"><t t-esc="periodTitle"/> · bar = actual as % of the full-period target<t t-if="c.period.days"> · pro-rata <t t-esc="proRataPct"/>%</t></div>
          <table class="t">
            <thead><tr><th>Category</th><th class="r">Actual <t t-esc="d.currency"/></th><th class="r">Target</th><th class="r">Var. to pro-rata</th><th>Achieved</th></tr></thead>
            <tbody>
              <t t-foreach="c.categories" t-as="cat" t-key="cat.key">
                <tr t-on-click="() => this.open('payment.log', cat.domain, cat.label)">
                  <td><t t-esc="cat.label"/><t t-if="cat.key === 'other' and cat.actual"> ⚠</t></td><td class="r" t-esc="fmtInt(cat.actual)"/>
                  <td class="r" t-esc="cat.target !== null ? fmtInt(cat.target) : '—'"/>
                  <td class="r"><t t-if="cat.variance !== null"><span t-att-class="'st ' + (cat.variance >= 0 ? 'fav' : 'unf')"><t t-esc="cat.variance >= 0 ? '▲' : '▼'"/> <t t-esc="fmtInt(Math.abs(cat.variance))"/></span></t><t t-else="">—</t></td>
                  <td style="min-width:120px"><t t-if="cat.target"><span class="minibar" style="position:relative"><i t-att-style="'width:' + achievedWidth(cat) + '%'"/></span> <span class="muted" t-esc="fmtPct(cat.achieved)"/></t><span class="muted" t-else="">no target</span></td>
                </tr>
              </t>
              <tr class="total"><td>Total</td><td class="r" t-esc="fmtInt(c.total)"/><td class="r" t-esc="c.target_total !== null ? fmtInt(c.target_total) : '—'"/>
                <td class="r"><t t-if="c.variance !== null" t-esc="fmtInt(c.variance)"/></td><td><t t-if="c.vs_target !== null" t-esc="fmtPct(c.vs_target)"/></td></tr>
            </tbody>
          </table>
        </div>
        <div class="gh-mcard" t-if="ok('financing')"><span class="kc">C15 · C16</span>
          <div class="gh-mhead slate">Collections vs financing repayments</div>
          <div class="gh-mbody">
            <t t-if="!d.financing.has_data">
              <div class="empty"><b>Awaiting lender schedules</b>Load facilities and repayment schedules under Configuration › Lender facilities. Foreign-currency obligations convert at the Odoo rate for the period.</div>
              <div style="margin-top:16px;opacity:.55">
                <div class="wf"><div class="wf-l"><span>Instalment cash collected (last month)</span><span t-esc="fmtMoney(d.financing.instalment_cash)"/></div><div class="wf-b"><i style="width:100%;background:var(--gh-green)"/></div></div>
                <div class="wf"><div class="wf-l"><span>Debt service due</span><span>—</span></div><div class="wf-b"><i style="width:0"/></div></div>
              </div>
            </t>
            <t t-else="">
              <div class="wf"><div class="wf-l"><span>Instalment cash collected (last month)</span><span t-esc="fmtMoney(d.financing.instalment_cash)"/></div><div class="wf-b"><i style="width:100%;background:var(--gh-green)"/></div></div>
              <t t-foreach="d.financing.by_lender" t-as="l" t-key="l.lender">
                <div class="wf"><div class="wf-l"><span>Debt service · <t t-esc="l.lender"/></span><span t-esc="fmtMoney(l.due)"/></div>
                  <div class="wf-b"><i t-att-style="'width:' + Math.min(100, 100 * l.due / Math.max(d.financing.instalment_cash, 1)) + '%;background:var(--gh-red)'"/></div></div>
              </t>
            </t>
            <div class="gh-fill"/>
            <div class="tot"><div><div class="tot-l">Debt-service collection coverage</div><div class="tot-c">Cash coverage ratio. This is not a formal DSCR</div></div>
              <div class="tot-n" t-att-style="d.financing.coverage ? '' : 'color:var(--gh-ink-soft)'"><t t-esc="d.financing.coverage ?? '—'"/>×</div></div>
          </div>
        </div>
      </div>
      </t>

      <div class="gh-row" style="grid-template-columns:minmax(0,1fr) minmax(0,1fr)">
        <div class="gh-panel"><span class="kc">C10</span>
          <h3 class="gh-h3">Collection rates over time</h3>
          <div class="gh-pcap">Collected ÷ scheduled dues per period · no 100% cap</div>
          <t t-if="ok('rate_trend') and d.rate_trend.periods.length >= 2">
            <div class="lg"><span><i class="ln" style="border-color:var(--s-zembo)"/>Active contracts</span><span><i class="ln" style="border-color:var(--s-niu)"/>Entire fleet</span></div>
            <GhChart kind="'line'" config="rateChart"/>
          </t>
          <div class="empty" t-else=""><b>Awaiting history</b>Run the history backfill.</div>
        </div>
        <div class="gh-panel"><span class="kc">C11</span>
          <h3 class="gh-h3">Monthly collections vs amount due</h3>
          <div class="gh-pcap">Instalment receipts (bar) against scheduled dues (tick) · label = %</div>
          <t t-if="ok('monthly')">
            <div class="lg"><span><i class="sw" style="background:var(--gh-slate)"/>Collected</span><span><i class="ln" style="border-color:var(--gh-ink)"/>Due</span></div>
            <GhChart kind="'bar'" config="dueChart"/>
          </t>
        </div>
      </div>
      <div class="gh-row" style="grid-template-columns:minmax(0,1fr) minmax(0,1.3fr)">
        <div class="gh-panel" t-if="ok('by_model')"><span class="kc">C12 · C13</span>
          <h3 class="gh-h3">Collections by bike model</h3>
          <div class="gh-pcap"><t t-esc="d.by_model.month"/> · performance = collected ÷ due for that product group</div>
          <table class="t">
            <thead><tr><th>Product group</th><th class="r">Collected</th><th class="r">Share</th><th class="r">Due</th><th class="r">Performance</th></tr></thead>
            <tbody>
              <t t-foreach="d.by_model.rows" t-as="r" t-key="r_index">
                <tr><td><i class="sw" t-att-style="'background:' + slotColor(r.slot)"/><t t-esc="r.label"/><t t-if="r.warn"> ⚠</t></td>
                  <td class="r" t-esc="fmtMoney(r.collected)"/><td class="r" t-esc="fmtPct(r.share)"/><td class="r" t-esc="fmtMoney(r.due)"/><td class="r"><b t-esc="fmtPct(r.performance)"/></td></tr>
              </t>
              <tr class="total"><td>Total</td><td class="r" t-esc="fmtMoney(d.by_model.total)"/><td class="r">100%</td><td class="r" t-esc="fmtMoney(d.by_model.total_due)"/>
                <td class="r" t-esc="fmtPct(d.by_model.total_due ? 100 * d.by_model.total / d.by_model.total_due : null)"/></tr>
            </tbody>
          </table>
        </div>
        <div class="gh-panel" t-if="ok('forecast')"><span class="kc">C17</span>
          <h3 class="gh-h3">Cash collection forecast</h3>
          <div class="gh-pcap">Next <t t-esc="d.forecast.weeks.length"/> weeks from active contracts. Risk-adjusted applies trailing <t t-esc="d.forecast.window"/>-week rates by risk category</div>
          <div class="lg"><span><i class="sw" style="background:var(--s-zembo)"/>Contractual</span><span><i class="sw" style="background:var(--s-niu)"/>Risk-adjusted</span></div>
          <GhChart kind="'bar'" config="forecastChart"/>
          <div class="gh-assume" t-if="!d.forecast.rates_complete">Some risk categories have no trailing history yet; their dues are counted at 100%.</div>
        </div>
      </div>

      <div class="gh-panel" t-if="ok('defaults')" style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap">
        <div><h3 class="gh-h3">Defaults &amp; losses</h3><div class="gh-pcap" style="margin:4px 0 0">Same component and numbers as on Portfolio &amp; Credit Risk</div></div>
        <div style="display:flex;gap:28px;flex-wrap:wrap">
          <div><div class="gh-tile-l" style="min-height:0">Default rate</div><div class="gh-tile-n crit" style="font-size:24px" t-esc="fmtPct(d.defaults.rate.value)"/></div>
          <div><div class="gh-tile-l" style="min-height:0">Arrears in default</div><div class="gh-tile-n" style="font-size:24px" t-esc="fmtInt(d.defaults.arrears_in_default)"/></div>
          <div><div class="gh-tile-l" style="min-height:0">Losses YTD</div><div class="gh-tile-n" style="font-size:24px" t-esc="d.defaults.losses_ytd !== null ? fmtMoney(d.defaults.losses_ytd) : '—'"/></div>
          <div><div class="gh-tile-l" style="min-height:0">Loss / revenue (last month)</div><div class="gh-tile-n" style="font-size:24px"
               t-esc="d.defaults.monthly.length &gt; 1 and d.defaults.monthly[d.defaults.monthly.length - 2].loss_pct !== null ? fmtPct(d.defaults.monthly[d.defaults.monthly.length - 2].loss_pct) : '—'"/></div>
        </div>
        <a href="#" style="font:500 12px var(--gh-sans);color:var(--gh-blue-step)" t-on-click.prevent="goPortfolio">Open in Portfolio →</a>
      </div>
    </div>
  </div>
  </t>
</div>
</t>
</templates>
