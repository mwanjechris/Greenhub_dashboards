<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sunday 23:30 Africa/Kampala = 20:30 UTC. Live KPIs are exact only for
         "today", so the job writes the week that ends on the day it runs. -->
    <record id="ir_cron_gh_weekly_snapshot" model="ir.cron">
        <field name="name">Green Hub Dashboards: weekly KPI snapshot</field>
        <field name="model_id" ref="model_gh_kpi_snapshot"/>
        <field name="state">code</field>
        <field name="code">model._cron_weekly_snapshot()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=20, minute=30, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_gh_licence_reminders" model="ir.cron">
        <field name="name">Green Hub Dashboards: licence expiry reminders</field>
        <field name="model_id" ref="model_gh_licence_reminder"/>
        <field name="state">code</field>
        <field name="code">model._cron_licence_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
